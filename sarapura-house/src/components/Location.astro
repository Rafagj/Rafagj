---
import { site } from '../data/content';
const mapsQuery = encodeURIComponent(site.address);
---

<section class="section location" id="ubicacion">
  <div class="wrap location-grid">
    <div class="location-info">
      <p class="eyebrow" data-reveal>Ubicación</p>
      <h2 class="location-title" data-reveal style="--delay: 80ms">
        En el corazón<br /> de Buenos Aires
      </h2>
      <p class="location-text" data-reveal style="--delay: 140ms">
        A pasos de los grandes hitos del centro porteño, Sarapura house se levanta sobre una de las
        avenidas más emblemáticas de la ciudad.
      </p>

      <dl class="location-meta" data-reveal style="--delay: 200ms">
        <div>
          <dt>Dirección</dt>
          <dd>{site.address}</dd>
        </div>
        <div>
          <dt>Barrio</dt>
          <dd>{site.neighborhood}</dd>
        </div>
      </dl>

      <a
        class="btn location-btn"
        href={`https://www.google.com/maps/search/?api=1&query=${mapsQuery}`}
        target="_blank"
        rel="noopener noreferrer"
        data-reveal
        style="--delay: 260ms"
      >
        Ver en el mapa
      </a>
    </div>

    <a
      class="location-map"
      href={`https://www.google.com/maps/search/?api=1&query=${mapsQuery}`}
      target="_blank"
      rel="noopener noreferrer"
      data-reveal
      aria-label="Abrir ubicación en Google Maps"
    >
      <img src="/gallery/mapa.svg" alt={`Mapa de ${site.neighborhood}`} loading="lazy" />
      <span class="location-pin" aria-hidden="true">
        <span class="pin-dot"></span>
        <span class="pin-label">Sarapura house</span>
      </span>
    </a>
  </div>
</section>

<style>
  .location {
    background: var(--paper);
  }
  .location-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }
  .location-title {
    font-size: clamp(2rem, 1.4rem + 2.6vw, 3.6rem);
    margin-bottom: 1.5rem;
  }
  .location-text {
    color: var(--ink-soft);
    max-width: 44ch;
  }

  .location-meta {
    display: grid;
    gap: 1.5rem;
    margin: 2.5rem 0;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }
  .location-meta dt {
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--bronze);
    margin-bottom: 0.35rem;
  }
  .location-meta dd {
    margin: 0;
    font-family: var(--serif);
    font-size: 1.25rem;
    color: var(--ink);
  }

  .location-map {
    position: relative;
    display: block;
    aspect-ratio: 5 / 4;
    overflow: hidden;
    border-radius: var(--radius);
    box-shadow: 0 24px 60px rgba(40, 28, 16, 0.14);
  }
  .location-map img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease);
  }
  .location-map:hover img {
    transform: scale(1.04);
  }
  .location-pin {
    position: absolute;
    top: 46%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
  }
  .pin-dot {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--bronze-deep);
    box-shadow: 0 0 0 6px rgba(154, 107, 63, 0.25), 0 0 0 14px rgba(154, 107, 63, 0.12);
    animation: ping 2.4s var(--ease) infinite;
  }
  @keyframes ping {
    0%,
    100% {
      box-shadow: 0 0 0 6px rgba(154, 107, 63, 0.25), 0 0 0 14px rgba(154, 107, 63, 0.12);
    }
    50% {
      box-shadow: 0 0 0 9px rgba(154, 107, 63, 0.3), 0 0 0 20px rgba(154, 107, 63, 0.05);
    }
  }
  .pin-label {
    font-family: var(--serif);
    font-size: 1rem;
    background: var(--ink);
    color: var(--cream);
    padding: 0.3rem 0.85rem;
    border-radius: 100px;
    white-space: nowrap;
  }

  @media (max-width: 820px) {
    .location-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
