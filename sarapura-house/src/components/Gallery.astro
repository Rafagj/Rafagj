---
import { gallery } from '../data/content';
---

<section class="section gallery" id="galeria">
  <div class="wrap gallery-head">
    <p class="eyebrow" data-reveal>Galería</p>
    <h2 class="gallery-title" data-reveal style="--delay: 80ms">Un recorrido por la casa</h2>
    <p class="gallery-note" data-reveal style="--delay: 140ms">
      Clic en cualquier imagen para verla en grande.
    </p>
  </div>

  <div class="wrap">
    <div class="grid">
      {
        gallery.map((img, i) => (
          <button
            class={`tile tile--${img.span}`}
            data-lightbox
            data-index={i}
            data-reveal
            style={`--delay: ${(i % 4) * 70}ms`}
            aria-label={`Ampliar: ${img.alt}`}
          >
            <img src={img.src} alt={img.alt} loading="lazy" />
            <span class="tile-zoom" aria-hidden="true">＋</span>
          </button>
        ))
      }
    </div>
  </div>
</section>

<!-- Lightbox -->
<div class="lightbox" data-lb hidden>
  <button class="lb-close" data-lb-close aria-label="Cerrar">×</button>
  <button class="lb-nav lb-prev" data-lb-prev aria-label="Anterior">‹</button>
  <figure class="lb-figure">
    <img data-lb-img alt="" />
    <figcaption data-lb-cap></figcaption>
  </figure>
  <button class="lb-nav lb-next" data-lb-next aria-label="Siguiente">›</button>
</div>

<style>
  .gallery {
    background: var(--paper);
  }
  .gallery-head {
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .gallery-title {
    font-size: clamp(2rem, 1.4rem + 2.6vw, 3.6rem);
  }
  .gallery-note {
    margin: 1rem 0 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: 220px;
    gap: clamp(0.6rem, 1.4vw, 1rem);
  }

  .tile {
    position: relative;
    overflow: hidden;
    border: 0;
    padding: 0;
    cursor: pointer;
    background: var(--paper-2);
    border-radius: var(--radius);
  }
  .tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--ease), filter 0.6s var(--ease);
  }
  .tile::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(20, 16, 12, 0);
    transition: background 0.5s var(--ease);
  }
  .tile:hover img {
    transform: scale(1.06);
  }
  .tile:hover::after {
    background: rgba(20, 16, 12, 0.18);
  }
  .tile-zoom {
    position: absolute;
    right: 14px;
    bottom: 12px;
    z-index: 2;
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: color-mix(in srgb, var(--cream) 90%, transparent);
    color: var(--ink);
    font-size: 1.2rem;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.4s var(--ease), transform 0.4s var(--ease);
  }
  .tile:hover .tile-zoom {
    opacity: 1;
    transform: none;
  }

  .tile--wide {
    grid-column: span 2;
  }
  .tile--tall {
    grid-row: span 2;
  }

  @media (max-width: 880px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 180px;
    }
    .tile--wide {
      grid-column: span 2;
    }
    .tile--tall {
      grid-row: span 1;
    }
  }
  @media (max-width: 480px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .tile--wide {
      grid-column: span 1;
    }
  }

  /* Lightbox */
  .lightbox[hidden] {
    display: none;
  }
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(16, 12, 9, 0.94);
    backdrop-filter: blur(6px);
    opacity: 0;
    transition: opacity 0.4s var(--ease);
    padding: clamp(1rem, 4vw, 3rem);
  }
  .lightbox:not([hidden]) {
    animation: lbIn 0.4s var(--ease) forwards;
  }
  @keyframes lbIn {
    to {
      opacity: 1;
    }
  }
  .lb-figure {
    margin: 0;
    max-width: min(1100px, 92vw);
    max-height: 86vh;
    text-align: center;
  }
  .lb-figure img {
    max-width: 100%;
    max-height: 76vh;
    object-fit: contain;
    border-radius: var(--radius);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5);
  }
  .lb-figure figcaption {
    margin-top: 1rem;
    color: rgba(251, 248, 242, 0.78);
    font-family: var(--serif);
    font-size: 1.05rem;
    font-style: italic;
  }
  .lb-close,
  .lb-nav {
    position: absolute;
    background: none;
    border: 0;
    color: var(--cream);
    cursor: pointer;
    line-height: 1;
    transition: color 0.3s var(--ease), transform 0.3s var(--ease);
  }
  .lb-close {
    top: clamp(1rem, 3vw, 2rem);
    right: clamp(1rem, 3vw, 2.5rem);
    font-size: 2.6rem;
  }
  .lb-nav {
    top: 50%;
    transform: translateY(-50%);
    font-size: 3.5rem;
    padding: 0 1rem;
  }
  .lb-prev {
    left: clamp(0.25rem, 2vw, 1.5rem);
  }
  .lb-next {
    right: clamp(0.25rem, 2vw, 1.5rem);
  }
  .lb-close:hover,
  .lb-nav:hover {
    color: var(--gold);
  }
  .lb-nav:hover {
    transform: translateY(-50%) scale(1.15);
  }
</style>

<script>
  import { gallery } from '../data/content';

  const lb = document.querySelector('[data-lb]') as HTMLElement | null;
  const lbImg = document.querySelector('[data-lb-img]') as HTMLImageElement | null;
  const lbCap = document.querySelector('[data-lb-cap]') as HTMLElement | null;
  let current = 0;

  const open = (i: number) => {
    current = (i + gallery.length) % gallery.length;
    const item = gallery[current];
    if (!lb || !lbImg || !lbCap) return;
    lbImg.src = item.src;
    lbImg.alt = item.alt;
    lbCap.textContent = item.alt;
    lb.hidden = false;
    document.body.style.overflow = 'hidden';
  };

  const close = () => {
    if (!lb) return;
    lb.hidden = true;
    document.body.style.overflow = '';
  };

  document.querySelectorAll('[data-lightbox]').forEach((btn) => {
    btn.addEventListener('click', () => open(Number(btn.getAttribute('data-index'))));
  });

  document.querySelector('[data-lb-close]')?.addEventListener('click', close);
  document.querySelector('[data-lb-prev]')?.addEventListener('click', () => open(current - 1));
  document.querySelector('[data-lb-next]')?.addEventListener('click', () => open(current + 1));
  lb?.addEventListener('click', (e) => {
    if (e.target === lb) close();
  });

  window.addEventListener('keydown', (e) => {
    if (lb?.hidden) return;
    if (e.key === 'Escape') close();
    if (e.key === 'ArrowLeft') open(current - 1);
    if (e.key === 'ArrowRight') open(current + 1);
  });
</script>
